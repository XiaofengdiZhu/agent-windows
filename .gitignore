# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Reference code (not part of this project)
reference/

# Native launcher build output. The prebuilt exe is generated by `build.cmd`
# (local) or `cargo build --release` (CI) and staged in prebuilt/ — it is NOT
# committed. Cargo's own target/ dir is build output too.
src/launcher/prebuilt/*.exe
src/launcher/target/

# IDE
.idea/
.vscode/
*.swp

# OS
Thumbs.db
.DS_Store
# Windows reserved device name "nul": redirecting to `nul` in Git Bash
# (e.g. `cmd > nul`) creates a real empty file instead of discarding output
# the way cmd.exe does. Ignore it so it never pollutes the tree.
nul

# Temp
temp/